<policies>
  <inbound>
    <base />
    <!-- Route to the Foundry backend and sign in with the gateway's managed identity (no keys). -->
    <set-backend-service backend-id="foundry" />
    <authentication-managed-identity resource="https://cognitiveservices.azure.com" />
    <!-- Cap token use per gateway subscription; the remaining budget is returned in a response header. -->
    <llm-token-limit counter-key="@(context.Subscription.Id)" tokens-per-minute="60000" estimate-prompt-tokens="true" remaining-tokens-header-name="x-remaining-tokens" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
