<policies>
  <inbound>
    <base />
    <!-- The tools service only accepts calls that carry this key; it never reaches the client. -->
    <set-header name="x-backend-key" exists-action="override">
      <value>{{libraryiq-backend-key}}</value>
    </set-header>
    <!-- Who is calling, from the subscription the key belongs to. Callers cannot set these headers. In
         production the same headers come from the signed-in user's token claims. -->
    <set-header name="x-user-id" exists-action="override">
      <value>@(context.Subscription.Name == "demo-librarian" ? "sam.librarian@example.org" : "alex.requester@example.org")</value>
    </set-header>
    <set-header name="x-user-role" exists-action="override">
      <value>@(context.Subscription.Name == "demo-librarian" ? "librarian" : "requester")</value>
    </set-header>
    <!-- Cap tool calls per gateway subscription. -->
    <rate-limit-by-key calls="60" renewal-period="60" counter-key="@(context.Subscription.Id)" />
  </inbound>
  <backend>
    <forward-request buffer-response="false" />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
