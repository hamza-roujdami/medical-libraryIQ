# Copy to .env and adjust. Settings are read with the LIBRARYIQ_ prefix.

# Agent: the model and the tools are reached only through the AI gateway (API Management).
LIBRARYIQ_GATEWAY_URL=https://<apim-name>.azure-api.net/openai/v1
LIBRARYIQ_GATEWAY_API_KEY=<gateway subscription key>
LIBRARYIQ_MODEL=<deployment name>
LIBRARYIQ_TOOLS_MCP_URL=https://<apim-name>.azure-api.net/library/mcp
# The librarian agent uses its own gateway key, which gives it the librarian role.
LIBRARYIQ_LIBRARIAN_API_KEY=<librarian gateway subscription key>

# Tools server (libraryiq.server): the library tools, served over MCP.
# Sent to Crossref, PubMed and Unpaywall as their requested contact address.
LIBRARYIQ_CONTACT_EMAIL=libraryiq-demo@example.org
LIBRARYIQ_LIBRARIAN_EMAIL=librarian@example.org
LIBRARYIQ_REQUESTER=demo.user@example.org
LIBRARYIQ_DATABASE_PATH=libraryiq.db
# Calls must carry this key in x-backend-key; the gateway adds it. Leave empty for local runs.
LIBRARYIQ_BACKEND_KEY=

# Evals only: the tools server's direct address, which must run with test endpoints enabled.
LIBRARYIQ_ENABLE_TEST_ENDPOINTS=false
LIBRARYIQ_EVAL_SERVICE_URL=http://localhost:8000
